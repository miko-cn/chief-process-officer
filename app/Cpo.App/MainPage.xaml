<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Cpo.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Cpo.App"
    xmlns:vm="using:Cpo.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题与说明 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="CPO 操作日志 (M3)" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="引擎自动执行的每一次干预与恢复记录，每 2 秒自动刷新（最新在最上面）。数据经 gRPC over named pipes 实时获取。"
                Style="{StaticResource CaptionTextBlockStyle}"
                Opacity="0.7"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 状态卡片 -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
            <StackPanel Spacing="8">
                <TextBlock
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind ViewModel.ServiceInfo, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Opacity="0.7"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 操作日志列表（最新在最上面；上限 20 行 → 用非虚拟化 StackPanel，避免增量插入时容器回收导致行闪烁） -->
        <ListView
            Grid.Row="2"
            x:Name="EventsList"
            ItemsSource="{x:Bind ViewModel.Events, Mode=OneWay}"
            AutomationProperties.AutomationId="EventsList"
            AutomationProperties.Name="操作日志">
            <ListView.ItemContainerTransitions>
                <!-- 日志视图：禁用增删/重定位过渡动画——否则底部行淡出会与顶部插入的下滑动画重叠 -->
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:EventRow">
                    <Grid ColumnSpacing="12" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="{x:Bind Time}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind Type}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.8"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind Summary}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
